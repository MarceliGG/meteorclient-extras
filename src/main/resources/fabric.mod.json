{
  "schemaVersion": 1,
  "id": "meteor-addon-meteo",
  "version": "${version}",
  "name": "Meteor Extras",
  "description": "An addon for Meteor Client.",
  "authors": [
    "seasnail"
  ],
  "contact": {
    "sources": "https://github.com/MarceliGG/meteorclient-extras"
  },
  "icon": "assets/meteorextras/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "pl.marceligg.meteorextras.Addon"
    ]
  },
  "mixins": [
    "meteorextras.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}